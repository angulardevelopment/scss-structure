{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../out-tsc/app",
    "types": [
      "node"
    ]
  },
  "exclude": [
    "test.ts",
    "**/*.spec.ts",
    "stories",
    "**/*.stories.ts",
    "environments/environment.prod.ts"
  ],
  "files": [
    "./main.ts",
    "./polyfills.ts"
  ],
  "include": [
    "src/**/*.d.ts",
    "**/*.ts"
  ]
}
